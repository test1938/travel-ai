# Copy to .env and fill in. Never commit .env.

# --- AI provider: google-genai (Gemini, default) or openai. Only the chosen provider needs a key. ---
AI_PROVIDER=google-genai
# Embeddings follow AI_PROVIDER; set this only to mix (e.g. OpenAI chat + Gemini embeddings). Changing the
# embedding provider re-embeds the knowledge base once at the next start (about 1 minute, a fraction of a cent).
# AI_EMBEDDING_PROVIDER=google-genai
# Gemini key from Google AI Studio (https://aistudio.google.com/apikey). Older .env files call it AI_API_KEY:
# that still works as long as GEMINI_API_KEY is not also present (an empty line counts as present).
GEMINI_API_KEY=
# OpenAI key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
# Optional model overrides (defaults: gemini-2.5-flash, gpt-4.1-mini; embeddings gemini-embedding-001,
# text-embedding-3-small). Cheapest OpenAI option: gpt-4.1-nano.
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# OPENAI_CHAT_MODEL=gpt-4.1-mini

# --- Database: docker-compose.yml (dev) and compose.prod.yml both read these ---
DB_URL=jdbc:postgresql://localhost:5432/travelpilot
DB_USER=tp
DB_PASSWORD=tp
# Any long random string (>= 32 chars) to sign guest tokens; empty = random per start (tokens lost on restart)
GUEST_TOKEN_SECRET=
# Backend port for local runs (default 8088; the Vite dev proxy then needs BACKEND_URL=http://localhost:<port>)
# SERVER_PORT=8088
# Open-Meteo forecast (no key needed); set false to plan without weather (offline demo)
WEATHER_ENABLED=true
# --- compose.prod.yml only ---
# Domain for automatic HTTPS (Caddy + Let's Encrypt), e.g. travelpilot.example.com; ":80" = plain HTTP
SITE_ADDRESS=:80
HTTP_PORT=80
